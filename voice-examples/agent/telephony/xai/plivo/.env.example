# XAI API Configuration (Required)
XAI_API_KEY=your-xai-api-key-here

# API Endpoint (Required)
API_URL=wss://api.x.ai/v1/realtime

# Server Configuration (Required for Plivo webhooks / Stream URL)
HOSTNAME=https://your-server-hostname.ngrok.com

# Optional: Server Port (defaults to 3000)
# PORT=3000

# Plivo credentials (required for outbound calls, end-call tool, and auto-provisioning)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# Optional: existing Plivo Application ID to update on startup.
# If unset and auto-provisioning is enabled, a new application named PLIVO_APP_NAME is created.
# PLIVO_APP_ID=
# PLIVO_APP_NAME=xai-plivo-telephony

# Set to false to skip creating/updating the Plivo Application and attaching the number
# AUTO_PROVISION=true

# For outbound calling
TARGET_PHONE_NUMBER=
